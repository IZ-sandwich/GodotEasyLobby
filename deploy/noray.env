# noray configuration for EasyLobby.
#
# The join code IS the OpenID. These two lines are what turn noray's default
# 21-character nanoid into a shareable 6-character code.
#
# The charset must match EasyLobby.CODE_ALPHABET in the addon.
# 23 characters, no I/L/O and no digits, so codes survive being read aloud.
NORAY_OID_LENGTH=6
NORAY_OID_CHARSET=ABCDEFGHJKMNPQRSTUVWXYZ

# Word-style codes ("brave-otter-lamp") are an alternative: easier over voice
# chat, longer to type. Set NORAY_ENABLE_WORDS_OID=true to use them instead,
# and widen EasyLobby.CODE_ALPHABET to accept letters plus hyphens.

NORAY_SOCKET_HOST=0.0.0.0
NORAY_SOCKET_PORT=8890
NORAY_HTTP_HOST=127.0.0.1
NORAY_HTTP_PORT=8891
NORAY_UDP_REGISTRAR_PORT=8809

# One port per relayed peer, so this range is the hard cap on concurrent
# relayed players. 2048 is noray's default.
NORAY_UDP_RELAY_PORTS=49152-51200
NORAY_UDP_RELAY_TIMEOUT=30s
NORAY_UDP_RELAY_CLEANUP_INTERVAL=30s

# Abuse controls, in bytes/sec. 128kb per relay is far above what a game needs;
# raise it only if you have measured a reason to.
NORAY_UDP_RELAY_MAX_INDIVIDUAL_TRAFFIC=128kb
NORAY_UDP_RELAY_MAX_GLOBAL_TRAFFIC=1Gb
NORAY_UDP_RELAY_TRAFFIC_INTERVAL=100ms

# A relayed session is cut off at whichever of these it hits first. Raise both
# for long-session games, or players will be dropped mid-match.
NORAY_UDP_RELAY_MAX_LIFETIME_DURATION=4hr
NORAY_UDP_RELAY_MAX_LIFETIME_TRAFFIC=4Gb

NORAY_LOGLEVEL=info
