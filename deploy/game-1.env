# Overrides for game-1, layered on top of noray.env.
#
# Add only what needs to differ from every other game on this box. Anything not
# mentioned here comes from the shared file.

# Clients reach this instance here. Must match easy_lobby/noray/port and
# easy_lobby/noray/registrar_port in game-1's Godot project settings.
NORAY_SOCKET_PORT=8890
NORAY_UDP_REGISTRAR_PORT=8809

NORAY_HTTP_HOST=127.0.0.1
NORAY_HTTP_PORT=8891

NORAY_UDP_RELAY_PORTS=61000-62023
